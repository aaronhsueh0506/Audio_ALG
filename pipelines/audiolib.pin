# Expected git commit of the sibling audiolib checkout (AUDIOLIB_DIR, default
# ../../audiolib). audiolib is not a submodule, so this file plus
# `make check-pins` is the source-level record of which audiolib
# revision this Audio_ALG revision was built and tested against. Bump it in
# the same commit that bumps the lib/aec and lib/nr submodule gitlinks.
AUDIOLIB_COMMIT=2ac99714de0f1801292af337e062029245bb88d7
