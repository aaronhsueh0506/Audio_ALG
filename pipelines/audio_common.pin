# Expected git commit of the sibling audio_common checkout (AC_DIR, default
# ../../audio_common). audio_common is not a submodule, so this file plus
# `make check-pins` is the source-level record of which audio_common
# revision this Audio_ALG revision was built and tested against. Bump it in
# the same commit that bumps the lib/aec and lib/nr submodule gitlinks.
AUDIO_COMMON_COMMIT=0b4c3a15e20a6ff29fabf3b178731cca275834df
