# machine-specific built binary (regenerable via make in pipelines/)
pipelines/aec_nr_pipeline

# build artifacts (extensionless pipeline binaries + objects)
pipelines/aec_nr_pipeline
pipelines/aec_nr_pipeline_static
pipelines/test_audio_pipeline
pipelines/libaudio_pipeline.a
lib/hpf/obj/
*.o

# pipelines/Makefile's own hash-keyed object AND binary dirs (obj|bin/
# <backend>-<config-hash>/, one subdirectory per distinct BACKEND/WERROR/
# NO_STDIO/... combination -- see the OBJ_DIR/BIN_DIR/CFG_SIG comment in that
# Makefile; round-3 review B01). pipelines/dist/ (publish's immutable release
# dir) is already covered by the generic `dist/` entry above.
pipelines/obj/
pipelines/bin/

# Same hash-keyed obj/bin scheme, 4ch_pipelines' own Makefile + its
# third_party/ sub-Makefile (2026-08-03: these were missing and showing up
# in `git status`, flagged by review).
pipelines/4ch_pipelines/obj/
pipelines/4ch_pipelines/bin/
pipelines/4ch_pipelines/third_party/obj/
pipelines/4ch_pipelines/third_party/bin/

# pytest's own cache (it writes a .gitignore inside, but be explicit)
.pytest_cache/

# Upstream GTCRN reference clone: 18 MB, carries its own .git, and holds the
# published .tar checkpoints.  Kept locally for source comparison only.
# Vendoring it properly (submodule, or a copy with .git removed) is a separate
# decision -- see GTCRN/GTCRN_Analysis.md for what was read out of it.
AINR/gtcrn_github/

# Third-party listening-test assets (local clone of the Align-ULCNet paper's
# demo page, github.com/fhgainr/alignulcnet-aenr): nested .git + unclear mp3
# licensing -- keep local-only, re-clone on other machines when needed.
AIAEC/wav_testset/
